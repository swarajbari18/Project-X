// This whole file describes ONE Worker. That is why no line says "worker".
{
  // This Worker's name on Cloudflare.
  "name": "tiny-situation-registrar",

  // The one file the bundler starts from. Whatever this Worker offers must be exported from here.
  "main": "src/front_door.ts",

  // Which version of Cloudflare's runtime behaviour this code expects.
  "compatibility_date": "2026-11-04",

  // WHAT THIS WORKER'S CODE CONTAINS.
  // The class called SituationRegistrar is a Durable Object class, and each object gets its own SQLite.
  "exports": {
    "SituationRegistrar": { "type": "durable-object", "storage": "sqlite" }
  },

  // WHAT THIS WORKER'S CODE MAY REACH.
  // Put a door at env.SITUATION_REGISTRAR, and make it lead to that class.
  "durable_objects": {
    "bindings": [{ "name": "SITUATION_REGISTRAR", "class_name": "SituationRegistrar" }]
  },

  // One block per stage. Doors must be repeated, because each stage is a separate Worker.
  "env": {
    "simulation": {
      "exports": {
        "SituationRegistrar": { "type": "durable-object", "storage": "sqlite" }
      },
      "durable_objects": {
        "bindings": [{ "name": "SITUATION_REGISTRAR", "class_name": "SituationRegistrar" }]
      }
    }
  }
}
